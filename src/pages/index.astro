---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Commonplace — Questions answered with primary sources</title>
    <meta name="description" content="Detailed answers to questions people actually ask about programming, finance, and architecture — backed by primary sources." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/" class="wordmark">Commonplace</a>
        <p class="tagline">Questions answered with primary sources.</p>
        <ul class="topics" aria-label="Topics covered">
          <li>Programming</li>
          <li>Finance</li>
          <li>Architecture</li>
        </ul>
      </header>

      <main>
        {posts.length === 0 ? (
          <p class="empty">No posts yet.</p>
        ) : (
          <ol class="post-list">
            {posts.map((post) => (
              <li>
                <a href={`/posts/${post.id}`}>
                  <span class="question">{post.data.question}</span>
                  <span class="meta">
                    {post.data.topics[0] && (
                      <span class="topic">{post.data.topics[0]}</span>
                    )}
                    <time datetime={post.data.publishedAt.toISOString()}>
                      {post.data.publishedAt.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        )}
      </main>

      <footer>
        <p>Primary sources only — papers, official docs, original interviews.</p>
      </footer>
    </div>
  </body>
</html>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    -webkit-text-size-adjust: 100%;
  }

  body {
    background: #F9F8F5;
    color: #1A1A18;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }

  .container {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* ── Header ─────────────────────────────────── */

  header {
    padding: 2.75rem 0 2rem;
    border-bottom: 1px solid #DDD9D1;
    margin-bottom: 0;
  }

  .wordmark {
    font-family: 'Lora', Georgia, 'Times New Roman', serif;
    font-size: 1.875rem;
    font-weight: 600;
    color: #1A1A18;
    text-decoration: none;
    letter-spacing: -0.025em;
    display: block;
    margin-bottom: 0.3rem;
  }

  .wordmark:hover {
    color: #1A1A18;
  }

  .tagline {
    font-size: 0.9375rem;
    color: #6B6860;
    margin-bottom: 1.25rem;
  }

  .topics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .topics li {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #6B6860;
    border: 1px solid #D5D0C8;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
  }

  /* ── Post list ───────────────────────────────── */

  .post-list {
    list-style: none;
  }

  .post-list > li {
    border-bottom: 1px solid #DDD9D1;
  }

  .post-list > li:first-child {
    border-top: 1px solid #DDD9D1;
  }

  .post-list a {
    display: block;
    padding: 1.25rem 0;
    text-decoration: none;
    color: inherit;
  }

  .post-list a:hover .question {
    color: #2B5BDB;
  }

  .question {
    display: block;
    font-family: 'Lora', Georgia, 'Times New Roman', serif;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: #1A1A18;
    margin-bottom: 0.5rem;
    transition: color 0.12s ease;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: #9C9891;
  }

  .meta::before {
    display: none;
  }

  .topic {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #6B6860;
  }

  .meta .topic + time::before {
    content: '·';
    margin-right: 0.625rem;
  }

  time {
    font-variant-numeric: tabular-nums;
  }

  /* ── Empty state ─────────────────────────────── */

  .empty {
    color: #9C9891;
    font-style: italic;
    padding: 3rem 0;
  }

  /* ── Footer ──────────────────────────────────── */

  footer {
    padding: 2rem 0;
    font-size: 0.8125rem;
    color: #9C9891;
    border-top: 1px solid #DDD9D1;
    margin-top: 0;
  }

  footer p {
    font-style: italic;
  }

  /* ── Responsive ──────────────────────────────── */

  @media (min-width: 640px) {
    header {
      padding: 3.5rem 0 2.25rem;
    }

    .wordmark {
      font-size: 2.25rem;
    }

    .question {
      font-size: 1.125rem;
    }

    .post-list a {
      padding: 1.375rem 0;
    }
  }
</style>
