---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const publishedDate = post.data.publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.data.title} — Commonplace</title>
    <meta name="description" content={post.data.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="container">
      <nav>
        <a href="/" class="back-link">← Commonplace</a>
      </nav>

      <article>
        <header>
          <h1>{post.data.question}</h1>
          <div class="article-meta">
            {post.data.topics.map((t) => (
              <span class="topic">{t}</span>
            ))}
            <time datetime={post.data.publishedAt.toISOString()}>{publishedDate}</time>
          </div>
        </header>

        <div class="prose">
          <Content />
        </div>
      </article>

      <footer>
        <a href="/" class="back-link">← Back to all questions</a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    -webkit-text-size-adjust: 100%;
  }

  body {
    background: #F9F8F5;
    color: #1A1A18;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }

  .container {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* ── Nav ─────────────────────────────────────── */

  nav {
    padding: 1.5rem 0;
    border-bottom: 1px solid #DDD9D1;
    margin-bottom: 2.5rem;
  }

  .back-link {
    font-size: 0.875rem;
    color: #6B6860;
    text-decoration: none;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
  }

  .back-link:hover {
    color: #1A1A18;
  }

  /* ── Article header ──────────────────────────── */

  article > header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #DDD9D1;
  }

  article > header h1 {
    font-family: 'Lora', Georgia, 'Times New Roman', serif;
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #1A1A18;
    margin-bottom: 1rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: #9C9891;
  }

  .topic {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #6B6860;
    border: 1px solid #D5D0C8;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
  }

  .article-meta time {
    font-variant-numeric: tabular-nums;
  }

  .article-meta .topic + time::before {
    content: '·';
    margin-right: 0.5rem;
  }

  /* ── Prose ───────────────────────────────────── */

  .prose {
    font-family: 'Lora', Georgia, 'Times New Roman', serif;
    font-size: 1.0625rem;
    line-height: 1.78;
    color: #1A1A18;
  }

  .prose p {
    margin-bottom: 1.375rem;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  /* Section separators from --- in MDX */
  .prose hr {
    border: none;
    border-top: 1px solid #DDD9D1;
    margin: 2.5rem 0;
  }

  /* H2 — section headings */
  .prose h2 {
    font-family: 'Lora', Georgia, serif;
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: #1A1A18;
    margin-top: 2.5rem;
    margin-bottom: 0.875rem;
  }

  /* H3 — subsection headings */
  .prose h3 {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6B6860;
    margin-top: 2rem;
    margin-bottom: 0.625rem;
  }

  /* Blockquotes */
  .prose blockquote {
    border-left: 3px solid #DDD9D1;
    margin: 1.75rem 0;
    padding: 0.125rem 0 0.125rem 1.25rem;
    color: #4A4A47;
  }

  .prose blockquote p {
    font-style: italic;
    margin-bottom: 0.5rem;
  }

  .prose blockquote p:last-child {
    margin-bottom: 0;
  }

  /* Links */
  .prose a {
    color: #2B5BDB;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .prose a:hover {
    color: #1A3FA0;
  }

  /* Lists */
  .prose ul,
  .prose ol {
    padding-left: 1.5rem;
    margin-bottom: 1.375rem;
  }

  .prose li {
    margin-bottom: 0.375rem;
  }

  .prose li:last-child {
    margin-bottom: 0;
  }

  /* Sources — ol at the bottom */
  .prose > ol:last-child {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #4A4A47;
  }

  .prose > ol:last-child li {
    margin-bottom: 0.625rem;
  }

  /* Strong / emphasis */
  .prose strong {
    font-weight: 600;
    color: #1A1A18;
  }

  .prose em {
    font-style: italic;
  }

  /* Inline code */
  .prose code {
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.875em;
    background: #EFEDE8;
    border-radius: 3px;
    padding: 0.1em 0.35em;
    color: #2D2D2B;
  }

  /* Code blocks */
  .prose pre {
    background: #1E1E1C;
    color: #D4D0C8;
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.75rem 0;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  /* Tables (comparison template) */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    margin: 1.75rem 0;
  }

  .prose th {
    text-align: left;
    font-weight: 500;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6B6860;
    border-bottom: 2px solid #DDD9D1;
    padding: 0.5rem 0.75rem 0.5rem 0;
  }

  .prose td {
    border-bottom: 1px solid #EDEAE4;
    padding: 0.625rem 0.75rem 0.625rem 0;
    vertical-align: top;
    color: #1A1A18;
  }

  .prose tr:last-child td {
    border-bottom: none;
  }

  /* ── Footer ──────────────────────────────────── */

  footer {
    padding: 2.5rem 0 3rem;
    border-top: 1px solid #DDD9D1;
    margin-top: 3rem;
  }

  /* ── Responsive ──────────────────────────────── */

  @media (min-width: 640px) {
    nav {
      padding: 2rem 0;
    }

    article > header {
      margin-bottom: 3rem;
    }

    article > header h1 {
      font-size: 2rem;
    }

    .prose {
      font-size: 1.125rem;
    }

    .prose h2 {
      font-size: 1.4375rem;
    }
  }
</style>
